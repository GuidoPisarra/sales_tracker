# Copiá este archivo a .env (o .env.local) y completá los valores reales.
# Nunca subas el .env con datos reales al repo.
APP_ENV=prod
APP_SECRET=cambiar
APP_URL_FRONT=https://kontia-app.vercel.app

# Base de datos (DSN de PDO)
BD_COM="mysql:host=127.0.0.1;port=3306;dbname=kontia;charset=utf8mb4"
USUARIO_BD_COM=usuario
PASSWORD_BD_COM=clave

# JWT (php bin/console lexik:jwt:generate-keypair)
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=cambiar
JWT_TTL=3600

# La app (kontia-app.vercel.app), la web (kontia-web-app.vercel.app), las vistas previas
# de Vercel, la app Android (capacitor://localhost y http://localhost) y desarrollo local.
CORS_ALLOW_ORIGIN='^(https://kontia(-web)?-app(-[a-z0-9-]+)?\.vercel\.app|capacitor://localhost|https?://(localhost|127\.0\.0\.1)(:[0-9]+)?)$'

# Mail (verificación de cuenta y recuperación de clave)
MAILER_DSN=null://null
MAIL_FROM="Kontia <no-responder@ventas-xpress.com.ar>"
# Avisos internos (altas, planes, cobros, cancelaciones). Varios separados por coma.
ADMIN_EMAILS=

# Asistente IA
AGENTE_IA_URL=

# Registro: captcha de Cloudflare Turnstile (vacío = sin captcha)
TURNSTILE_SECRET=

# Ingreso con Google: uno o más Client ID separados por coma (web, Android)
GOOGLE_CLIENT_IDS=

# Prueba gratis
DIAS_PRUEBA=7
PLAN_PRUEBA=pro
DIAS_GRACIA_MORA=7

# Mercado Pago (Suscripciones / preapproval)
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_BACK_URL=https://kontia-app.vercel.app/mi-plan

# Datos legales que muestran Términos y Privacidad (los lee el front por /api/publico/info)
LEGAL_TITULAR="Vipi Labs"
LEGAL_CUIT=20-32668607-8
LEGAL_PROVINCIA="Buenos Aires"

# Soporte: botón de Ayuda de la app y mails
SOPORTE_EMAIL=vipilabs2026@gmail.com
SOPORTE_WHATSAPP=5492983694278

# Mail a ADMIN_EMAILS cuando la API da un error 500 (1 por error por hora). 0 = apagado.
AVISAR_ERRORES=1
